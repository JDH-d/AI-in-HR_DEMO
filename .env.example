# OpenAI API key for AI answers and embeddings; empty enables local search/workflows.
OPENAI_API_KEY=
# Generation model available to your OpenAI key; unused when the key is empty.
OPENAI_MODEL=gpt-5-nano-2025-08-07
# Shared login password for Employee, Manager and Knowledge Admin; generated if empty.
DEMO_LOGIN_PASSWORD=
# Secret for signing login tokens; generated if empty. Never commit the resulting .env.
DEMO_AUTH_SECRET=
# SQLite, index, settings and logs. Existing installations keep their data folder.
DATA_DIR=data
# Optional Slack/Discord setup uses server environment variables or .env.integrations.
# See README.md: Slack and Discord setup. Keep bot tokens out of this example.
