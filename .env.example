OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-nano-2025-08-07
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
EMBEDDING_MODEL=text-embedding-3-small

DEMO_AUTH_SECRET=replace-with-a-long-random-secret
DEMO_LOGIN_PASSWORD=demo-password
DEMO_TOKEN_TTL_SECONDS=28800
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

DOCUMENTS_DIR=documents
INDEX_PATH=data/index.json
INDEX_STATUS_PATH=data/index_status.json
LOG_PATH=data/chat_logs.jsonl
WORKFLOW_DB=data/workflow.db
SYSTEM_PROMPT_PATH=data/system_prompt.txt
AI_SETTINGS_PATH=data/ai_settings.json
LOG_USER_TEXT_MODE=masked

SLACK_NOTIFICATIONS_ENABLED=false
SLACK_WEBHOOK_URL=
SLACK_TIMEOUT_SECONDS=3
PUBLIC_WEB_BASE_URL=http://127.0.0.1:5173

API_BASE_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000
