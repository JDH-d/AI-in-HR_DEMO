{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "${TEAMS_APP_ID}",
  "developer": {
    "name": "MVP Bot",
    "websiteUrl": "${BOT_BASE_URL}",
    "privacyUrl": "${BOT_BASE_URL}/privacy",
    "termsOfUseUrl": "${BOT_BASE_URL}/terms"
  },
  "name": {
    "short": "${BOT_DISPLAY_NAME}",
    "full": "${BOT_DISPLAY_NAME}"
  },
  "description": {
    "short": "Company knowledge assistant",
    "full": "A personal Microsoft Teams bot that answers company knowledge-base questions using approved internal documents."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#2563EB",
  "bots": [
    {
      "botId": "${MICROSOFT_APP_ID}",
      "scopes": [
        "personal"
      ],
      "isNotificationOnly": false,
      "supportsCalling": false,
      "supportsVideo": false,
      "supportsFiles": false
    }
  ],
  "validDomains": [
    "${BOT_DOMAIN}"
  ]
}

